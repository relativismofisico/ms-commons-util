<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Ruleset consolidado de la plataforma Integrity — mismo checkstyle.xml en los
  10 backends. Antes de esta unificación existían 3 configuraciones distintas
  copiadas por bloques entre repos (con reglas reales distintas, no solo
  formato); esta versión toma como base la más madura de las 3 (la que ya
  tenía supresiones documentadas y convención de test BDD) y suma los checks
  útiles de las otras dos que no tenían equivalente acá.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Permite suprimir un check puntual con @SuppressWarnings("checkstyle:NombreDelCheck")
         directo en el código, para casos legítimos específicos de un método/clase sin
         tener que tocar este archivo compartido por los 10 repos. -->
    <module name="SuppressWarningsFilter"/>

    <!-- ================================================================
         File-level checks
         ================================================================ -->
    <module name="NewlineAtEndOfFile"/>
    <module name="FileLength">
        <property name="max" value="1200"/>
    </module>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>
    <module name="LineLength">
        <property name="max" value="180"/>
        <property name="ignorePattern" value="^package|^import|https?://"/>
    </module>

    <!-- ================================================================
         Suppressions comunes a los 10 repos
         ================================================================ -->
    <!-- La clase principal de Spring Boot usa SpringApplication.run(), no
         necesita constructor privado de utility class. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="HideUtilityClassConstructor"/>
        <property name="files" value=".*[/\\][A-Za-z]*Application\.java$"/>
    </module>

    <!-- Architecture test usa constantes UPPER_SNAKE para legibilidad -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="ConstantName"/>
        <property name="files" value=".*[/\\]ArchitectureTest\.java$"/>
    </module>

    <!-- FileLength: ArchitectureTest agrupa muchas reglas, es esperable que sea largo -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="FileLength"/>
        <property name="files" value=".*[/\\]ArchitectureTest\.java$"/>
    </module>

    <!-- Tests: nombres BDD (methodName_escenario_esperado, con guiones bajos) -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MethodName"/>
        <property name="files" value=".*Test\.java$"/>
    </module>

    <!-- Tests: números mágicos aceptables (códigos HTTP, expiración JWT, etc.) -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MagicNumber"/>
        <property name="files" value=".*Test\.java$"/>
    </module>

    <!-- Tests: comentarios de fin de línea aceptables (// given, // when, // then) -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="TrailingComment"/>
        <property name="files" value=".*Test\.java$"/>
    </module>

    <!-- Interfaces Spring Data JPA: el guión bajo en nombres tipo findByUser_Id es sintaxis
         real de property-expression para navegar asociaciones anidadas, no una cuestión de
         estilo — renombrar rompería la derivación de la query. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="MethodName"/>
        <property name="files" value=".*[/\\][A-Za-z]*Repository\.java$"/>
    </module>

    <!-- ms-consultasFacturas-neg usa `com.msconsultaFacturasneg` como paquete raíz — tiene
         una mayúscula en medio del nombre, no cumple la convención estándar de Java de
         paquetes 100% minúscula. Renombrar el paquete completo (declaración + imports +
         carpetas en ~60 archivos) es un refactor grande y riesgoso que no corresponde a
         esta fase de unificación de checkstyle; queda documentado como deuda aparte. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="PackageName"/>
        <property name="files" value=".*[/\\]com[/\\]msconsultaFacturasneg[/\\].*\.java$"/>
    </module>

    <!-- RequireThis: clases Spring-managed (@Service/@Component/@Controller) usan
         inyección por constructor; parámetros locales a veces sombrean campos a
         propósito en builders — se relaja en las capas típicas donde esto pasa.
         Cada repo puede ampliar este patrón de carpetas en su propio ruleset si
         su estructura de paquetes lo requiere. -->
    <module name="SuppressionSingleFilter">
        <property name="checks" value="RequireThis"/>
        <property name="files" value=".*[/\\](service|serviceimpl|controller|security|kafka|client|config|calculadora)[/\\].*\.java$"/>
    </module>

    <!-- ================================================================
         TreeWalker checks
         ================================================================ -->
    <module name="TreeWalker">

        <module name="SuppressWarningsHolder"/>

        <!-- ── Imports ─────────────────────────────────────────────── -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STATIC###STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE"/>
            <property name="separateLineBetweenGroups" value="true"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
        </module>

        <!-- Prohíbe el uso de APIs internas del JDK/contenedor -->
        <module name="IllegalImport">
            <property name="illegalPkgs" value="org.apache.tomcat, sun, com.sun"/>
        </module>

        <!-- ── Javadoc ─────────────────────────────────────────────── -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowedAnnotations"
                      value="Override,Test,BeforeEach,AfterEach,BeforeAll,AfterAll,ParameterizedTest,Bean,
                             KafkaListener,Scheduled,PostMapping,GetMapping,PutMapping,DeleteMapping,
                             PatchMapping,RequestMapping,ExceptionHandler"/>
        </module>
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="true"/>
            <property name="endOfSentenceFormat" value="([.?!][ \t\n\r\f&lt;])|([.?!]$)"/>
        </module>

        <!-- ── Naming ──────────────────────────────────────────────── -->
        <module name="OuterTypeFilename"/>
        <module name="ConstantName"/>
        <module name="LocalFinalVariableName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="MethodName"/>
        <!-- Permite guión bajo en un segmento del paquete (ej. com.security.ms_security) —
             varios repos de la plataforma ya lo usan así en el nombre del módulo raíz. -->
        <module name="PackageName">
            <property name="format" value="^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)*$"/>
        </module>
        <module name="ParameterName"/>
        <module name="StaticVariableName"/>
        <module name="TypeName"/>
        <module name="CatchParameterName"/>

        <!-- ── Tamaños ─────────────────────────────────────────────── -->
        <module name="MethodLength">
            <property name="max" value="150"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="8"/>
        </module>

        <!-- ── Coding style ────────────────────────────────────────── -->
        <module name="AvoidInlineConditionals"/>
        <module name="DefaultComesLast"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="FallThrough"/>
        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="InnerAssignment"/>
        <module name="MagicNumber">
            <property name="ignoreNumbers" value="-1, 0, 1, 2"/>
            <property name="ignoreAnnotation" value="true"/>
            <property name="ignoreHashCodeMethod" value="true"/>
        </module>
        <module name="MissingSwitchDefault"/>
        <module name="ModifiedControlVariable"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="NoFinalizer"/>
        <module name="OneStatementPerLine"/>
        <module name="RequireThis">
            <property name="checkMethods" value="false"/>
        </module>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="SuperClone"/>
        <module name="SuperFinalize"/>
        <module name="TodoComment"/>
        <module name="UnnecessaryParentheses"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <module name="AnnotationLocation">
            <property name="allowSamelineSingleParameterlessAnnotation" value="true"/>
            <property name="allowSamelineParameterizedAnnotation" value="false"/>
            <property name="allowSamelineMultipleAnnotations" value="false"/>
        </module>

        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL, CHAR_LITERAL"/>
            <property name="format"
                      value="\\u00(09|0A|0B|0C|0D)|\\u0085|\\u2028|\\u2029"/>
            <property name="message"
                      value="Avoid escaped control characters in literals; use visible escaped forms."/>
        </module>

        <!-- ── Blocks ──────────────────────────────────────────────── -->
        <module name="AvoidNestedBlocks"/>
        <module name="EmptyBlock"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignore|ignored"/>
        </module>
        <module name="LeftCurly"/>
        <module name="NeedBraces"/>
        <module name="RightCurly"/>

        <!-- ── Whitespace ──────────────────────────────────────────── -->
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="OperatorWrap"/>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>

        <module name="SeparatorWrap">
            <property name="option" value="eol"/>
            <property name="tokens" value="COMMA,SEMI,ELLIPSIS,ARRAY_DECLARATOR"/>
        </module>

        <!-- ── Modifiers ───────────────────────────────────────────── -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- ── Trailing comments ───────────────────────────────────── -->
        <module name="TrailingComment"/>

    </module>
</module>
