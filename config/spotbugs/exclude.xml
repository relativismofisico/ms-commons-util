<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
            https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- ================================================================
         Dependency injection pattern
         RateLimitFilter almacena el StringRedisTemplate y el
         RateLimitResponseWriter recibidos por constructor — mismo patrón
         ya excluido en los 10 backends consumidores ("Spring-injected
         services store repository/template references by design"), acá
         además es una librería: el consumidor es quien decide qué
         instancia mutable pasar, es el contrato de la clase, no un
         descuido.
         ================================================================ -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.factoring.commons.web.RateLimitFilter"/>
    </Match>

    <!-- ================================================================
         Auditoría (0.4.0):
         - KafkaAuditoriaPublisher guarda el KafkaTemplate recibido por
           constructor: mismo caso que RateLimitFilter (lo crea la
           autoconfiguración y es exclusivo del publicador).
         - AuditoriaAccionEvent.detalle(): el constructor compacto del
           record ya lo deja como Map.copyOf (inmutable); SpotBugs no lo ve.
         ================================================================ -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.factoring.commons.auditoria.KafkaAuditoriaPublisher"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.factoring.commons.auditoria.AuditoriaAccionEvent"/>
    </Match>

    <!-- ================================================================
         Outbox de auditoría (0.5.0): el relay, la limpieza, el planificador
         y los adaptadores guardan las propiedades y el MongoTemplate que
         les pasa la autoconfiguración (mismo patrón de inyección por
         constructor que arriba); AuditoriaOutboxProperties expone su
         objeto anidado 'mongo' porque así lo enlaza Spring Boot.
         ================================================================ -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Package name="~com\.factoring\.commons\.auditoria\.outbox(\..*)?"/>
    </Match>

    <!-- ================================================================
         Outbox genérico y consumo idempotente (0.6.0): mismo patrón de
         inyección por constructor (el KafkaTemplate propio del publicador,
         el MongoTemplate y los gestores de transacciones del servicio).
         ================================================================ -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
        <Package name="~com\.factoring\.commons\.outbox(\..*)?"/>
    </Match>

    <!-- ================================================================
         SQL con nombre de tabla configurable (0.6.0): la tabla del outbox
         y la de las marcas de consumo son configurables por servicio, así
         que el nombre se concatena en el SQL. El constructor lo valida
         contra [A-Za-z][A-Za-z0-9_]{0,63} antes de usarlo, y todos los
         valores viajan siempre como parámetros (?), nunca concatenados.
         ================================================================ -->
    <Match>
        <Bug pattern="SQL_INJECTION_SPRING_JDBC"/>
        <Or>
            <Class name="com.factoring.commons.auditoria.outbox.jdbc.JdbcAuditoriaOutboxAdapter"/>
            <Class name="com.factoring.commons.outbox.idempotencia.JdbcConsumoIdempotente"/>
        </Or>
    </Match>

    <!-- ================================================================
         Test classes — exclude all SpotBugs analysis on tests
         Clases *Spec (Spock, único framework de test de este repo desde
         el día uno) más las clases internas que el compilador de Groovy
         genera para cada spec (closures $_nombreMetodo_closureN,
         $__spock_feature_N_N_closureN, etc.) — ver la lección documentada
         en el resto de la plataforma (Fase 10 del pipeline de
         mantenibilidad): sin esto, SpotBugs reporta como bugs reales los
         artefactos normales del compilador Groovy (getMetaClass()/
         setMetaClass(), closures Serializable sin serialVersionUID).
         ================================================================ -->
    <Match>
        <Class name="~.*Spec"/>
    </Match>

    <Match>
        <Class name="~.*Spec\$.*"/>
    </Match>

    <!-- Apoyo de las pruebas del outbox (base abstracta de las specs de
         integración, contenedores y reloj de prueba): mismo criterio que las
         *Spec, son clases Groovy de test con sus closures. -->
    <Match>
        <Class name="~com\.factoring\.commons\.auditoria\.outbox\.(OutboxIntegracionBase|KafkaDePrueba|RelojDePrueba|MedicionTomarLote)(\$.*)?"/>
    </Match>

</FindBugsFilter>
